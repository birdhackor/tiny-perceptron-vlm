      "kind": "official_source",
      "title": "Profiler EventList、FunctionEvent 與表格欄位",
      "url": "https://github.com/pytorch/pytorch/blob/5c4886908584029761b579af026dcfb627c84070/torch/autograd/profiler_util.py",
      "version": "PyTorch 2.14.1; git 5c4886908584029761b579af026dcfb627c84070",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-29",
      "authority_reason": "PyTorch 官方 repository，且 pin 等於本機 torch.version.git_version；直接閱讀該原始碼／內嵌官方文件。",
