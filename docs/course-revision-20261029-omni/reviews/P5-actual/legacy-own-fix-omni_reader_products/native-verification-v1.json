          "evidence_origin": "retained_from_v1; not newly read in v2"
        },
        {
          "evidence_pointer": "/current_source_evidence/cnn_local",
          "quote": "`AvgPool2d(2)` 每個通道各把不重疊的 2×2 區域加總除以 4",
