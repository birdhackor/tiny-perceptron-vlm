    "# @title 準備本節的工具（首次執行）\n",
    "from pathlib import Path\n",
    "import os\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "# Colab 會先下載專案；本機 Jupyter 沿用已開啟的 repo。\n",
    "try:\n",
    "    import google.colab\n",
    "except ImportError:\n",
    "    in_colab = False\n",
    "else:\n",
    "    in_colab = True\n",
    "\n",
    "if in_colab:\n",
    "    root = Path(\"/content/tiny-perceptron-vlm\")\n",
    "    if not root.exists():\n",
    "        subprocess.run(\n",
