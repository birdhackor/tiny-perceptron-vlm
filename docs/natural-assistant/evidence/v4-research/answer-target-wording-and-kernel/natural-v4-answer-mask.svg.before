<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 720" role="img" aria-labelledby="title desc">
  <title id="title">問題留在輸入，只有答案與結束的目標計分</title>
  <desc id="desc">手寫Q到A的六格小例子。輸入依次是起始、使用者、Q、結束、助理、A。已右移的目標只有最後兩格A與結束有效；助理邊界所在輸入位置預測第一個答案A。它不是完整圖文模型的序列長度。</desc>
  <defs><marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10Z" fill="#2563eb"/></marker></defs>
  <rect width="760" height="720" rx="24" fill="#f8fafc"/>
  <g font-family="Noto Sans CJK TC,Noto Sans CJK SC,sans-serif" fill="#17243b" text-anchor="middle">
    <text x="380" y="53" font-size="34" font-weight="700">問題留在輸入，答案才計分</text>
    <text x="380" y="102" font-size="30">手寫 Q → A 小例子</text>
    <text x="380" y="153" font-size="32">模型讀取的輸入 X</text>
    <g font-size="31">
      <rect x="37" y="174" width="106" height="84" rx="12" fill="#ffffff" stroke="#93a3b8" stroke-width="2"/><text x="90" y="226">起始</text>
      <rect x="151" y="174" width="106" height="84" rx="12" fill="#ffffff" stroke="#93a3b8" stroke-width="2"/><text x="204" y="226">使用者</text>
      <rect x="265" y="174" width="106" height="84" rx="12" fill="#ffffff" stroke="#93a3b8" stroke-width="2"/><text x="318" y="226">Q</text>
      <rect x="379" y="174" width="106" height="84" rx="12" fill="#ffffff" stroke="#93a3b8" stroke-width="2"/><text x="432" y="226">結束</text>
      <rect x="493" y="174" width="106" height="84" rx="12" fill="#ffffff" stroke="#2563eb" stroke-width="3"/><text x="546" y="226">助理</text>
      <rect x="607" y="174" width="106" height="84" rx="12" fill="#ffffff" stroke="#2563eb" stroke-width="3"/><text x="660" y="226">A</text>
    </g>
    <text x="380" y="325" font-size="32">下一項目標 Y（已右移）</text>
    <g font-size="33">
      <rect x="37" y="351" width="106" height="84" rx="12" fill="#e2e8f0"/><text x="90" y="403">—</text>
      <rect x="151" y="351" width="106" height="84" rx="12" fill="#e2e8f0"/><text x="204" y="403">—</text>
      <rect x="265" y="351" width="106" height="84" rx="12" fill="#e2e8f0"/><text x="318" y="403">—</text>
      <rect x="379" y="351" width="106" height="84" rx="12" fill="#e2e8f0"/><text x="432" y="403">—</text>
      <rect x="493" y="351" width="106" height="84" rx="12" fill="#dbeafe" stroke="#2563eb" stroke-width="3"/><text x="546" y="403">A</text>
      <rect x="607" y="351" width="106" height="84" rx="12" fill="#dbeafe" stroke="#2563eb" stroke-width="3"/><text x="660" y="403">結束</text>
    </g>
    <path d="M546 263V285" fill="none" stroke="#2563eb" stroke-width="3" marker-end="url(#arrow)"/>
    <path d="M660 263V285" fill="none" stroke="#2563eb" stroke-width="3" marker-end="url(#arrow)"/>
    <text x="380" y="484" font-size="31" fill="#1d4ed8">第一個答案由前面的助理邊界預測</text>
    <rect x="37" y="516" width="676" height="137" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
    <text x="380" y="563" font-size="30">灰色：不直接算這格的代價</text>
    <text x="380" y="613" font-size="30">藍色：答案 A 與結束都要學</text>
    <text x="380" y="691" font-size="28">本圖不是完整圖文模型的序列長度。</text>
  </g>
</svg>
