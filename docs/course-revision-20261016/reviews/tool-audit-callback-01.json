  "issues": [
    {
      "id": "TOOL-07",
      "necessity": "necessary",
      "status": "unresolved",
      "progress": "partially_resolved",
      "locations": [
        "docs/review-tools/incremental_revision.py:156",
        "docs/review-tools/incremental_revision.py:163"
      ],
      "probe_ids": [
        "basis_still_requests_revision",
        "basis_figure_version_not_bound"
      ],
      "details": "原最小ID/hash/pass假報告已拒絕，且新版basis原文hash不符也會拒絕；但把7.25實讀basis verdict改成需補說明，或把9.10 basis兩張圖的指紋清空，current metadata仍pass時，gate都回350頁passed_metadata_checks。basis只被核對owner/page/source，未核對明確拒絕狀態及所依據圖版本。這不能由僅metadata的current確認替代真正新稿／新圖核對。",
      "required_resolution": "保留原basis的豐富接受字串，不能一概要求重寫pass。明確revise/需補說明、必要未解事項或圖版本不符時，必須有同reader另存且可定位的實際知情重讀／裁定鏈；current basis引用須和該鏈一致。"
    },
    {
      "id": "TOOL-13",
      "necessity": "necessary",
      "status": "unresolved",
      "locations": [
        "docs/review-tools/incremental_revision.py:198"
      ],
      "probe_ids": [
        "closure_created_before_its_raw_observation"
      ],
      "details": "把7.23 checkpoint closure.created_at改成初始reader開始時點，早於該頁所有被收束原note及current judgment，保持真實較晚received_at後，gate仍350頁pass。現有檢查只要求created不早於reader階段起點，未要求晚於它聲稱已處置的觀察和最終判斷。",
      "required_resolution": "逐項closure建立時點不得早於所引用的raw note、basis/current判斷及需依賴的複查。較晚metadata補證仍保留真實較晚建立與technical收件時間，不倒填初始reader seal。"
    },
    {
      "id": "TOOL-14",
      "necessity": "necessary",
      "status": "unresolved",
      "locations": [
        "docs/course-revision-20261016/tools/reader.py:56",
        "docs/course-revision-20261016/tools/reader.py:180"
      ],
      "probe_ids": [
        "helper_skip_context_and_first_main_page"
      ],
      "details": "新plan雖綁reviewer/author/freeze且分離main/context，但全新reviewer沒有任何99.0 context收據、沒有第一main99.1 checkpoint，仍可直接start第二main99.2。正向路線能走通且全組選讀延後有效，卻未機械核對必要前文及main先後。",
      "required_resolution": "plan明確表示必要context及有序main路線；start核對同reviewer/plan/freeze的必要前文存取及先前main完成證據。若另有可選context，與必要context明列區別；不為舊session事後偽造plan。"
    },
    {
      "id": "TOOL-15",
      "necessity": "necessary",
      "status": "unresolved",
      "locations": [
        "docs/review-tools/incremental_revision.py:239",
        "docs/review-tools/incremental_revision.py:257"
      ],
      "probe_ids": [
        "new_basis_issue_omitted_from_issue_inventory",
        "closure_issue_omitted_from_issue_inventory"
      ],
      "details": "原note結構化issues現會被完整盤點；但proof.basis與checkpoint_closure是gate實際讀取的後補角色報告，卻沒有列入issue_reports必需集合。各自新增一項明確necessary/unresolved的結構化issue，不新增任何處置、也不列issue_reports，gate仍350頁pass。",
      "required_resolution": "從所有角色證據引用（包括basis、checkpoint closure、其他必要callback及後續dependency audit）衍生完整報告集合與問題集合，拒絕有必要未解事項卻宣告pass或漏列處置；不得只信手動issue_reports清單。"
    }
