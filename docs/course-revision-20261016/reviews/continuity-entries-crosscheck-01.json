  "major_method_checks": [
    {
      "topic": "入口導覽與方法預告",
      "reader_basis": [
        "course note-001/002/003",
        "reader-entries-closure-01 deferred項"
      ],
      "source_support": "R.2以讀者問題列承接節，R.3明列C與14的非節號順序，R.4把局部機制、從零權重、有限成品與成熟應用分開。導覽未用未教方法做計算或排名。",
      "decision": "agree",
      "adequacy": "導覽基本角色已足夠；完整Transformer、MTP、PPO等仍合理待各章，不升成全方法已教。",
      "independent_addition": "我實點22個兩viewport改序footer和手機選單；350導航／312lesson-index一致，補了讀者明列未驗的網站落點範圍。"
    },
    {
      "topic": "G.4方法角色與選擇目的",
      "reader_basis": [
        "glossary note-003/004"
      ],
      "source_support": "表首以少算、少存、品質、外部資訊提出需要；loop共享狀態、effort偏好、Jev集中度、終止深度／監督位置都給查詞級區別。末尾要求回具體例子解釋採用原因，未在詞表承諾演算法或實效已證。",
      "decision": "agree",
      "adequacy": "角色與查找目的足夠；normalization穩定理由、activation、RoPE、裁切與推測核對等完整機制保留待正文。",
      "technical_scope": "technical-G.4核對24術語／19主張群為角色正確，並非取代主要章的理解。G.4-revise只修原來源日期轉錄，教材沒改。"
    },
    {
      "topic": "T.10教師路線、CE/KL與六檔",
