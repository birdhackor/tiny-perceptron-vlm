  "scope": "Thirteen fresh independent CPU kernels after fixing evidence URLs to an already public immutable Git commit. This supplements the retained full 248-kernel run; unchanged notebooks are not rerun here. T.7 is a guide page with no notebook.",
  "verification_program": "import hashlib\nimport json\nimport subprocess\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nroot = Path.cwd()\nindex = json.loads((root / \"course/lesson-index.json\").read_text())\nselected = [\"13.15\", *[f\"19.{i}\" for i in range(1, 13)]]\nrecords = []\nfor lesson in selected:\n    item = next(item for item in index if item[\"id\"] == lesson)\n    source = root / item[\"notebook\"]\n    before = hashlib.sha256(source.read_bytes()).hexdigest()\n    command = [\n        \".venv/bin/python\", \"scripts/check_notebooks.py\", \"--mode\", \"kernel\", \"--workers\", \"1\",\n        \"--lesson\", lesson, \"--output\", \"outputs/integration-notebooks\",\n    ]\n    process = subprocess.run(command, cwd=root, capture_output=True, timeout=180, check=True)\n    report = json.loads((root / \"outputs/integration-notebooks/validation-kernel.json\").read_text())\n    assert report[\"total\"] == report[\"passed\"] == 1 and report[\"failed\"] == 0\n    assert before == hashlib.sha256(source.read_bytes()).hexdigest()\n    output = root / \"outputs/integration-notebooks\" / source.relative_to(root / \"notebooks\")\n    records.append({\n        \"lesson\": lesson,\n        \"command\": command,\n        \"report\": report,\n        \"source_sha256\": {\n            source.relative_to(root).as_posix(): before,\n            output.relative_to(root).as_posix(): hashlib.sha256(output.read_bytes()).hexdigest(),\n        },\n        \"stdout_sha256\": hashlib.sha256(process.stdout).hexdigest(),\n        \"stderr_sha256\": hashlib.sha256(process.stderr).hexdigest(),\n    })\n    print(f\"Fresh CPU kernel passed: {lesson}\", flush=True)\nproof = {\n    \"checked_at\": datetime.now(UTC).isoformat(),\n    \"status\": \"passed\", \"total\": len(records),\n    \"scope\": \"Thirteen fresh independent CPU kernels after fixing evidence URLs to an already public immutable Git commit. This supplements the retained full 248-kernel run; unchanged notebooks are not rerun here. T.7 is a guide page with no notebook.\",\n    \"verification_program\": Path(__file__).read_text(),\n    \"verification_program_sha256\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n    \"records\": records,\n}\n(root / \"docs/validation-artifacts/integration-pinned-evidence-kernels.json\").write_text(\n    json.dumps(proof, ensure_ascii=False, indent=2) + \"\\n\"\n)\n",
