  "verification_program": "\"\"\"Build a dated local preview only after all current technical results close.\"\"\"\nimport hashlib\nimport json\nimport os\nimport subprocess\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nroot = Path('/workspace/tiny-perceptron-vlm')\nstate = json.loads(Path('/tmp/technical-round-coordinator-state.json').read_text())\nassert len(state['completed_pass']) == 248\nassert not any(state.get(k) for k in ['active', 'awaiting_author', 'pending_recheck', 'recheck_active', 'format_pending'])\nrevision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()\nassert (root / 'docs/validation-artifacts/final-review-closure.json').exists()\nfiles = sorted(set(p for directory in ['course', 'notebooks'] for p in (root / directory).rglob('*') if p.is_file()))\nfiles += [root / p for p in ['scripts/export_course.py', 'scripts/check_site.py', 'scripts/build_course.py', 'zensical.toml']]\nsha = lambda raw: hashlib.sha256(raw).hexdigest()\nbefore = {p.relative_to(root).as_posix(): sha(p.read_bytes()) for p in files}\nenv = os.environ | {'OMP_NUM_THREADS': '1', 'MKL_NUM_THREADS': '1'}\nrecords = []\nfor command in [\n    ['.venv/bin/python', 'scripts/export_course.py', '--output', 'outputs/site-final-review', '--executed', 'outputs/notebooks-reader-round', '--revision', revision],\n    ['.venv/bin/python', 'scripts/check_site.py', '--site', 'outputs/site-final-review'],\n]:\n    started = datetime.now(timezone.utc).isoformat()\n    result = subprocess.run(command, cwd=root, env=env, capture_output=True, text=True)\n    records.append({'command': command, 'started_at': started, 'finished_at': datetime.now(timezone.utc).isoformat(), 'exit_code': result.returncode, 'stdout': result.stdout, 'stderr': result.stderr})\n    print(json.dumps({'command': command, 'exit_code': result.returncode}), flush=True)\n    if result.returncode:\n        raise RuntimeError(json.dumps(records[-1], ensure_ascii=False))\nassert before == {p.relative_to(root).as_posix(): sha(p.read_bytes()) for p in files}\ninfo = json.loads((root / 'outputs/site-final-review/build-info.json').read_text())\nassert info['revision'] == revision and info['executed_cpu_outputs'] is True and info['lessons'] == 222\nreport = {\n    'schema_version': 1, 'checked_at': datetime.now(timezone.utc).isoformat(), 'status': 'passed', 'revision': revision,\n    'scope': 'Actual local export after all248 genuine current technical results were consumed, using current saved real CPU kernel outputs; strict Zensical and link/download/immutable Colab pin checks. Source bytes remained unchanged. This records no new kernel or training execution, browser run, remote Colab execution, main publication, or paid-compute invoice.',\n    'source_sha256': before, 'build_info': info, 'records': records, 'verification_program': Path(__file__).read_text(),\n}\ntarget = root / 'outputs/final-preview-site-check.json'\nassert not target.exists()\ntarget.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\\n')\nprint(json.dumps({'status': 'passed', 'revision': revision, 'lessons': 222, 'source_files': len(before)}))\n"
