output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),'records':records,'verification_program':Path(__file__).read_text()}\np=root/'docs/validation-artifacts/kernel-environment-clarification.json';assert not p.exists();p.write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({'receipt':str(p.relative_to(root)),'records':len(records),'clarified_runner_fields':sum('Verification-program' in r['environment_python_interpretation'] for r in records)}))\n"
