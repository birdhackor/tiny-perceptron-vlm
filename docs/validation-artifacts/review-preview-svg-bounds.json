  "verification_program": "import fs from 'node:fs/promises';\nimport path from 'node:path';\nimport crypto from 'node:crypto';\nconst root='/workspace/tiny-perceptron-vlm';\nconst figureDir=path.join(root,'course/figures');\nconst destination=process.argv[2]||path.join(root,'outputs/browser-rehearsal/current-svg-bounds.json');\nconst startedAt=new Date().toISOString();\nconst names=(await fs.readdir(figureDir)).filter(n=>n.endsWith('.svg')).sort();\nconst sha=b=>crypto.createHash('sha256').update(b).digest('hex');\nconst version=await (await fetch('http://127.0.0.1:9233/json/version')).json();\nconst socket=new WebSocket(version.webSocketDebuggerUrl);\nawait new Promise((resolve,reject)=>{socket.onopen=resolve;socket.onerror=reject;});\nlet id=0;const pending=new Map();\nsocket.onmessage=e=>{const r=JSON.parse(e.data);if(r.id){const p=pending.get(r.id);pending.delete(r.id);r.error?p.reject(new Error(JSON.stringify(r.error))):p.resolve(r.result);}};\nconst call=(method,params={},sessionId)=>{const n=++id;return new Promise((resolve,reject)=>{pending.set(n,{resolve,reject});socket.send(JSON.stringify({id:n,method,params,...(sessionId?{sessionId}:{})}));});};\nconst {targetId}=await call('Target.createTarget',{url:'about:blank'});\nconst records=[];\ntry {\n const {sessionId}=await call('Target.attachToTarget',{targetId,flatten:true});\n const page=(method,params={})=>call(method,params,sessionId);\n await page('Page.enable');\n for(const name of names){\n  const raw=await fs.readFile(path.join(figureDir,name));\n  const viewBox=raw.toString().match(/viewBox=\"([^\"]+)\"/)[1].trim().split(/\\s+/).map(Number);\n  const width=688,height=Math.ceil(width*viewBox[3]/viewBox[2]);\n  await page('Emulation.setDeviceMetricsOverride',{width,height,deviceScaleFactor:1,mobile:false});\n  await page('Page.navigate',{url:'http://127.0.0.1:9411/figures/'+encodeURIComponent(name)+'?bounds='+Date.now()});\n  let ready=false;\n  for(let attempt=0;attempt<30;attempt++){\n   await new Promise(r=>setTimeout(r,100));\n   const r=await page('Runtime.evaluate',{expression:'document.readyState === \"complete\" && !!document.querySelector(\"svg\")',returnByValue:true});\n   if(r.result.value){ready=true;break;}\n  }\n  if(!ready)throw new Error('SVG did not load: '+name);\n  await page('Runtime.evaluate',{expression:'document.fonts.ready',awaitPromise:true});\n  const result=await page('Runtime.evaluate',{expression:`(()=>{const s=document.querySelector('svg');const b=s.viewBox.baseVal;const labels=[...s.querySelectorAll('text')].map(e=>{const r=e.getBBox(),m=s.getCTM().inverse().multiply(e.getCTM());const p=[[r.x,r.y],[r.x+r.width,r.y],[r.x,r.y+r.height],[r.x+r.width,r.y+r.height]].map(([x,y])=>new DOMPoint(x,y).matrixTransform(m));return {text:e.textContent,x:Math.min(...p.map(p=>p.x)),y:Math.min(...p.map(p=>p.y)),right:Math.max(...p.map(p=>p.x)),bottom:Math.max(...p.map(p=>p.y))}});return {labels:labels.length,outside:labels.filter(t=>t.x<b.x-0.001||t.y<b.y-0.001||t.right>b.x+b.width+0.001||t.bottom>b.y+b.height+0.001)}})()`,returnByValue:true});\n  if(result.exceptionDetails)throw new Error(JSON.stringify(result.exceptionDetails));\n  if(sha(await fs.readFile(path.join(figureDir,name)))!==sha(raw))throw new Error('Figure changed during check: '+name);\n  records.push({figure:'course/figures/'+name,sha256:sha(raw),viewport:{width,height},checkedAt:new Date().toISOString(),...result.result.value});\n }\n for(const record of records){if(sha(await fs.readFile(path.join(root,record.figure)))!==record.sha256)throw new Error('Figure changed before final scope check: '+record.figure);}\n const failures=records.filter(r=>r.outside.length);\n const report={schema_version:1,startedAt,checkedAt:new Date().toISOString(),status:failures.length?'failed':'passed',scope:'Actual Chromium SVG loading, document.fonts.ready and transformed text bounding boxes at a 688px desktop reading width. This checks text against the SVG viewBox, not semantic correctness, website page layout, animation or remote Colab execution.',browser:version.Browser,figures:records.length,failures:failures.length,records,verification_program:await fs.readFile('/tmp/check-all-svg-bounds.mjs','utf8')};\n await fs.mkdir(path.dirname(destination),{recursive:true});\n await fs.writeFile(destination,JSON.stringify(report,null,2)+'\\n');\n console.log(JSON.stringify({status:report.status,figures:report.figures,failures:report.failures,output:destination}));\n if(failures.length){console.log(JSON.stringify(failures));process.exitCode=1;}\n} finally {await call('Target.closeTarget',{targetId});socket.close();}\n"
}
