{"visited_at": "2026-10-05T23:20:20.336874+00:00", "page_id": "16.12", "url": "http://127.0.0.1:8765/16.12.html", "viewport": {"width": 1280, "height": 900}, "status": 200, "screenshots": [{"path": "/workspace/tiny-perceptron-vlm/docs/course-revision-20261005/continuity/artifacts/13_16/recheck-01/16.12-desktop-code0.png", "sha256": "a3274724fb8ed9e79fff64050dde0195acad2eee58661f8764da23d01488e1f7", "target": "main pre index 0", "image_src": null, "image_alt": null}], "code_text": "length = 8\nwindow = 3  # 包含目前位置\n\n\ndef visible(position):\n    return set(range(max(0, position - window + 1), position + 1))\n\n\nprint(\"位置7直接讀\", sorted(visible(7)))\ntwo_layers = set().union(*(visible(p) for p in visible(7)))\nprint(\"兩層可能傳來的來源\", sorted(two_layers))\nprint(\"完整因果配對\", sum(p + 1 for p in range(length)))\nprint(\"滑窗配對\", sum(len(visible(p)) for p in range(length)))\n", "code_class": ""}
