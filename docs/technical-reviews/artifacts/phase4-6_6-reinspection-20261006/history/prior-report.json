        },
        {
          "source_id": "hf_pipeline",
          "locator": "encode_single_sequence769–781；encode871–888；decode935–952；post_process1260–1305",
          "supports": "input literal匹配先於BPE，而add_special_tokens flag只傳postprocess；decoder可能skip已登記special"
        },
        {
          "source_id": "hf_api",
          "locator": "add_special_tokens693–711；decode846–860",
          "supports": "已有拼寫重用ID，新token新ID；完整token不經模型拆分及decode預設跳過"
        },
        {
