  "claims": [
    {
      "id": "C1",
      "kind": "numeric",
      "statement": "ByteTokenizer reserved ID依序0–7；UTF-8 byte加8後占8–263，總字表264；assistant=4、image=5；<的60變68、>的62變70，<image>為7個ASCII字符。",
      "location": "06.md#6.6 第2、4、7段及原fence",
      "scope": "本課ByteTokenizer的整數ID／byte與ASCII字符數；不含模型性能數字。",
      "status": "verified",
      "evidence": [
        {
          "source_id": "repo_data",
          "locator": "SPECIALS/ByteTokenizer lines11–28",
          "supports": "reserved順序、264、range(8)、byte+8"
        },
        {
          "source_id": "exec_fence",
          "locator": "stdout第1–3行",
          "supports": "八種ID、assistant字面完整ID清單"
        },
        {
          "source_id": "exec_variants",
          "locator": "byte與configuration_conditions；腳本整數assert",
          "supports": "min/max content IDs、偏移算式與<image>長度"
        }
      ],
      "artifact_ids": [
        "a-execution-original-fence-stdout_txt",
        "a-execution-boundary-checks_json",
        "a-code-boundary_checks_py"
      ],
      "verification": {
        "method": "executed",
        "expected": "8 reserved +256 bytes=264；content IDs8–263，60+8=68，62+8=70，assistant4、image5；<image>7字符。",
        "observed": "原fence列八種ID；14 byte cases均content8–263；全部整數assert通過。",
        "details": "逐byte Python嚴格UTF-8編碼，整數加法與len核對，ID是離散編號，無軸／損失單位或四捨五入。",
        "tolerance": "整數精確相等，容忍差0"
      }
    },
    {
      "id": "C2",
      "kind": "software",
      "statement": "普通字串<assistant>與<image>只成為byte內容ID，完整decode還原原拼寫；引用文字不被內容encode升格成role/modality ID。",
      "location": "06.md#6.6 開場、原fence、其解說與練習",
      "scope": "完整合法UTF-8字串由ByteTokenizer encode再decode；不是對任意生成／截斷byte序列的無損保證。",
      "status": "verified",
      "evidence": [
