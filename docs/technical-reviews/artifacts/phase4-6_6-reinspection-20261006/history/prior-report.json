        {
          "source_id": "exec_fence",
          "locator": "原fence stdout及execution.json exit_code0",
          "supports": "原例保持assistant拼寫並assert不含4"
        },
        {
          "source_id": "exec_variants",
          "locator": "byte14項；limitations.byte_partial_utf8",
          "supports": "image練習與八种拼寫未升格；也實查partial UTF8解碼限制"
        }
      ],
      "artifact_ids": [
        "a-execution-original-fence-fence-1_py",
        "a-execution-original-fence-execution_json",
        "a-execution-original-fence-stdout_txt",
        "a-execution-boundary-checks_json"
