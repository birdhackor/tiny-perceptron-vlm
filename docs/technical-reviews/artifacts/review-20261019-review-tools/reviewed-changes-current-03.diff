+def is_calendar_day(value):
+    """value 是不是 YYYY-MM-DD 寫法、而且真的存在的日期。"""
+    if not isinstance(value, str) or not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value):
+        return False
+    try:
+        date.fromisoformat(value)
+    except ValueError:
+        return False
+    return True
