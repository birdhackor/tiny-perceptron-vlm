      "url": "https://raw.githubusercontent.com/jaredpalmer/kev/2074cc44256200bb37540103fa4572901faa10f3/kev/metrics.py",
      "version": "2074cc44256200bb37540103fa4572901faa10f3",
      "original_acquired_on": "2026-10-30",
