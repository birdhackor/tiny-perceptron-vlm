  "front_matter_prerequisite_compatibility": {
    "W.1": {
      "report": {
        "path": "docs/course-revision-20261029-omni/reviews/P5-actual/technical-W.1/technical-original-v1.json",
        "sha256": "6487cbd09e356535ad9df3835262e07678b9c476e9a272f81b9888fb659a7de5"
      },
      "current_source": "course/first-steps.md#W.1",
      "key_claims": [
        {
          "id": "c06",
          "statement": "Colab準備格在偵測到google.colab後，若專案不存在先clone，再以當前Python執行pip install -e，然後使用專案root。",
          "scope": "只核實碼和模擬控制流；未登入、下載、安裝或執行真正Colab，正文已有未實測限制。"
        },
        {
          "id": "c07",
          "statement": "Colab是Google提供的雲端Notebook服務，其執行VM屬於使用者帳號。",
          "scope": "只核服務及帳號角色；不把未登入頁面取得當作雲端執行成功。"
        },
        {
          "id": "c10",
          "statement": "GIT_LFS_SKIP_SMUDGE=1使Git LFS保留追蹤檔的pointer而略過clone checkout時下載實體物件；乾淨的Git-only安裝也能clone含LFS指標的repo。",
          "scope": "skip-smudge語意由Git LFS原始文件核；無git-lfs的成功案例用乾淨配置本地fixture實測。不保證曾移除LFS但留下壞filter配置的既有Git環境。"
        },
        {
          "id": "c11",
          "statement": "Windows的core.longpaths=true可為C實作的Git clone/切換版本啟用長路徑；--global使設定持續適用該使用者的Git。",
          "scope": "官方Windows契約支持clone/checkout用途；本次只在Linux私有global config實跑設定，不當作Windows長路徑實測，不外推為所有Windows應用或腳本命令都無限制。"
        },
        {
          "id": "c12",
          "statement": "uv sync --frozen --extra cpu --group notebook以lock選版本，選CPU PyTorch來源並加入Notebook工具；預設專案環境為.venv。",
          "scope": "核命令/依賴選擇與現有CPU環境；本輪只dry-run，沒有重新下載或完整新裝，網路可用性不由此保證。"
        },
        {
          "id": "c13",
          "statement": "啟用venv會讓python使用該環境；不啟用也能以其Python路徑執行。",
          "scope": "Linux兩種寫法實跑；Windows/macOS相應路徑按官方文件核，未聲稱跨平台實測。"
        },
        {
          "id": "c14",
          "statement": "PowerShell執行原則可阻止Activate.ps1這類腳本；因此這種腳本載入錯誤本身不足以判定套件環境安裝失敗。",
          "scope": "只針對正文描述的執行原則錯誤，不把所有紅色錯誤都歸為同一原因。"
        },
        {
          "id": "c23",
          "statement": "git lfs version印git-lfs/開頭版本；git lfs install --local只在目前專案建立LFS配置/連結。",
          "scope": "Linux git-lfs3.6.1、獨立人工repo實跑；未對真專案改hooks或全域Git設定。"
        },
        {
          "id": "c24",
          "statement": "本課訓練資料包以LFS追蹤；操作頁的下載工具遇pointer會呼叫git lfs pull，讀教材及本節的短程式不需要這個下載步驟。",
          "scope": "核下載入口與本節短程式的依賴分工；未下載訓練資料、啟動訓練或聲稱任意未來示範都離線。"
        }
      ],
      "whole_page_compatibility": "Matches training front matter root/venv path, Git LFS, local terminal/Colab and generated output-path guidance; no additional device-completion claim."
    },
    "W.7": {
      "report": {
        "path": "docs/course-revision-20261029-omni/reviews/P5-actual/wave04/technical-W.7/current-v1.json",
        "sha256": "1fa7ad0e46902e721115d37cac3e017043a694b6843b87bd8f5f7861ebe5a210"
      },
      "current_source": "course/first-steps.md#W.7",
      "key_claims": [
        {
          "id": "c08",
          "statement": "uv sync 的預設專案環境是根目錄旁的 .venv/，此目錄不存入 Git。",
          "scope": "限 W.1 的預設專案流程；UV_PROJECT_ENVIRONMENT 或預覽功能可改位置，正文沒有聲稱涵蓋所有自訂配置。"
        },
        {
          "id": "c27",
          "statement": "相對路徑從目前工作目錄解讀；scripts/check_env.py 在根目錄可找到，在 notebooks/ 下不能沿同一相對路徑找到。",
          "scope": "不是所有檔名缺失都只由 cwd 造成；本節也要求核對檔名。"
        },
        {
          "id": "c28",
          "statement": "本節唯一 Python 圍欄查詢 cwd 與兩個相對路徑；根目錄後兩行為 True，改到 notebooks/ 會為 False。",
          "scope": "exists 回答存在與否，不保證檔案內容正確或可讀；本節只用於起點診斷。"
        },
        {
          "id": "c29",
          "statement": "工具箱可直接以 POSIX .venv/bin/python 或 Windows .\\.venv\\Scripts\\python.exe 啟動；切到 notebooks/ 後未啟用者用上一層路徑。",
          "scope": "以前置 W.1 已完成且採預設 .venv 為條件；啟用後 python 指向該環境的規則亦由官方 venv 文件支持。"
        }
      ],
