{
  "environment": {
    "python": "3.13.16",
    "torch": "2.14.1",
    "device": "cpu",
    "dtype": "float64"
  },
  "arithmetic": {
    "one_plus_two": 3,
    "wrong_answer": 4,
    "correctness_reward": 0,
    "counting_two_steps_from_one": [
      2,
      3
    ]
  },
  "ppo_single_sample": {
    "formula": "maximize min(r*A, clip(r, 1-epsilon, 1+epsilon)*A), r=p_new/p_old",
    "initial_theta": 0.0,
    "old_probability": 0.5,
    "advantage": 1.0,
    "epsilon": 0.2,
    "objective_at_start": 1.0,
    "gradient": 0.5,
    "learning_rate": 10.0,
    "new_theta": 5.0,
    "new_probability": 0.9933071490757153,
    "new_probability_ratio": 1.9866142981514305,
    "ratio_exceeds_clip_threshold": true,
    "scope": "一個合法 SGD ascent 更新的反例：clipped objective 並不投影更新後的機率。此學習率用於否定硬保證，不是訓練建議，也不是量測模型品質。"
  }
}
