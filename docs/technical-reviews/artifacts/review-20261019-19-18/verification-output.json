  "source_excerpts": {
    "auto_solve": "def auto_solve(b, c, state, effort=\"auto\", max_loops=5):\n    if effort not in (*EFFORT, \"auto\") or type(max_loops) is not int or not 1 <= max_loops <= 6:\n        raise ValueError(\"effort需為auto/low/medium/high，硬上限需為1–6\")\n    parsed = parse_state(state)\n    b.synchronize()\n    c.synchronize()\n    started = time.perf_counter()\n    choice = c.judge(state, \"choice\")\n    info = c.judge(state, \"info\")\n    result = {\"effort\": effort, \"max_loops\": max_loops, \"choice\": choice, \"info\": info, \"b_loops\": 0}\n    if choice[\"selected\"] not in (\"boxes\", \"sum\"):\n        result[\"status\"] = \"unsupported\"\n    elif info[\"selected\"] != \"yes\":\n        result[\"status\"] = \"clarification_needed\"\n    else:\n        if effort == \"auto\" and b.auto_policy is None:\n            raise ValueError(\"Auto需先載入policy集合選定並凍結的規則\")\n        requested = (\n            EFFORT[effort]\n            if effort != \"auto\"\n            else rule_depth(b.auto_policy, choice[\"selected\"], parsed.get(\"event_count\", 0))\n        )\n        actual = min(requested, max_loops)\n        result.update(requested_loops=requested, b_loops=actual)\n        try:\n            result[\"solution\"] = b.solve(state, loops=actual)\n            result[\"status\"] = \"budget_limited\" if actual < requested else \"answered\"\n        except ValueError as error:\n            result.update(status=\"input_contract_rejected\", b_loops=0, reason=str(error))\n    result[\"seconds\"] = time.perf_counter() - started\n    result[\"c_seconds\"] = choice[\"seconds\"] + info[\"seconds\"]\n    return result\n",
    "latency_report": "def latency_report(b, c, rows):\n    # 穩定ID抽樣，不依題目答對與否選快／簡單案例。\n    sample = sorted(rows, key=lambda row: hashlib.sha256((\"latency-v1:\" + row[\"id\"]).encode()).hexdigest())[:24]\n    result = {}\n    for effort in (\"low\", \"medium\", \"high\", \"auto\"):\n        for row in sample[:3]:\n            auto_solve(b, c, row[\"state\"], effort)\n        measurements, c_times, direct = [], [], []\n        for _ in range(3):\n            for row in sample:\n                answer = auto_solve(b, c, row[\"state\"], effort)\n                measurements.append(answer[\"seconds\"])\n                c_times.append(answer[\"c_seconds\"])\n                if effort != \"auto\":\n                    depth = {\"low\": 1, \"medium\": 3, \"high\": 5}[effort]\n                    direct.append(b.solve(row[\"state\"], depth)[\"seconds\"])\n        result[effort] = {\n            \"requests\": len(measurements),\n            \"integrated_mean_seconds\": statistics.mean(measurements),\n            \"integrated_median_seconds\": statistics.median(measurements),\n            \"integrated_p95_seconds\": sorted(measurements)[int(0.95 * (len(measurements) - 1))],\n            \"c_mean_seconds\": statistics.mean(c_times),\n            \"direct_b_mean_seconds\": statistics.mean(direct) if direct else None,\n        }\n    return {\n        \"sample_ids\": [row[\"id\"] for row in sample],\n        \"warmup_per_effort\": 3,\n        \"repetitions\": 3,\n        \"model_reload_excluded\": True,\n        \"batch_size\": 1,\n        \"device\": str(b.device),\n        \"threads\": torch.get_num_threads(),\n        \"python\": platform.python_version(),\n        \"torch\": torch.__version__,\n        \"measurements\": result,\n    }\n\n\n"
  },
