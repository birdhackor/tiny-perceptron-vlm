    "fence-1.py": {
      "sha256": "74fef3f0b94d3968bed712a48b954908c282d506646ef6ade943e1222810abde",
      "content": "import torch\nfrom torch import nn\nfrom tiny_perceptron.alignment import LoRALinear\n\ntorch.manual_seed(0)\nlayer = LoRALinear(nn.Linear(4, 3), rank=2, alpha=2)\nwith torch.no_grad():\n    layer.b.fill_(0.1)\n    adapter_a = {\"a\": layer.a.clone(), \"b\": layer.b.clone()}\n    layer.a.fill_(0.2)\n    layer.b.fill_(-0.1)\n    adapter_b = {\"a\": layer.a.clone(), \"b\": layer.b.clone()}\n    layer.a.copy_(adapter_a[\"a\"])\n    layer.b.copy_(adapter_a[\"b\"])\nprint(\"切回短答套的B平均\", round(layer.b.mean().item(), 2))\nprint(\"短答套兩個矩陣都恢復\", torch.equal(layer.a, adapter_a[\"a\"]) and torch.equal(layer.b, adapter_a[\"b\"]))\n"
    }
