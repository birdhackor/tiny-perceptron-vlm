    "fence-1.py": {
      "sha256": "cd8a99d580c01cb0f9bea7869f58dde3cdcf6d9291952c3b6349d33ef1ac10d9",
      "content": "import torch\nfrom torch import nn\n\nfrom tiny_perceptron.model import Block, ModelConfig\n\ntorch.manual_seed(0)\nconfig = ModelConfig(width=8)\nstacked = nn.ModuleList([Block(config) for _ in range(3)])\nshared = Block(config)\nlooped = nn.ModuleList([shared, shared, shared])\nfor name, blocks in [(\"堆疊\", stacked), (\"循環\", looped)]:\n    state = torch.randn(1, 3, 8)\n    for block in blocks:\n        state, _, _ = block(state)\n    count = sum(p.numel() for p in blocks.parameters())\n    print(name, \"參數\", count, \"區塊執行\", len(blocks), \"次\", \"輸出形狀\", list(state.shape))\n"
    },
    "bootstrap.py": {
      "sha256": "a6491127f74f29675c34bc392f42b8275592c1d3d57748ff80d1fa6b41c65ea3",
      "content": "# @title 準備本節的工具（首次執行）\nfrom pathlib import Path\nimport os\nimport subprocess\nimport sys\n\n# Colab 會先下載專案；本機 Jupyter 沿用已開啟的 repo。\ntry:\n    import google.colab\nexcept ImportError:\n    in_colab = False\nelse:\n    in_colab = True\n\nif in_colab:\n    root = Path(\"/content/tiny-perceptron-vlm\")\n    if not root.exists():\n        subprocess.run(\n            [\"git\", \"clone\", \"--depth\", \"1\", \"https://github.com/birdhackor/tiny-perceptron-vlm.git\", str(root)],\n            env={**os.environ, \"GIT_LFS_SKIP_SMUDGE\": \"1\"},\n            check=True,\n        )\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--quiet\", \"-e\", str(root)], check=True)\n    os.chdir(root)\n\nroot = Path.cwd().resolve()\nwhile not (root / \"pyproject.toml\").exists() and root != root.parent:\n    root = root.parent\nif not (root / \"tiny_perceptron\").is_dir():\n    raise RuntimeError(\"本機請先依 course/first-steps.md 開啟 repo；免安裝練習可使用本節的 Colab 入口\")\nsys.path.insert(0, str(root))\nimport torch\n\ntorch.set_num_threads(1)\ntorch.manual_seed(42)\n"
