      "snapshot": "docs/course-review-20261019/freeze-01/sources/A.9.md",
      "source_sha256": "de61ffb1d46d2e9a0a1f295addcd309c17436a0e8b165f8034b34f5436bcd869",
      "body_python_blocks": [
        {
