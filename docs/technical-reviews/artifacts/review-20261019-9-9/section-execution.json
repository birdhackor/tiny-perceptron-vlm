  "code": "import torch\n\nscores = torch.tensor([[2.0, 1.0, 0.0]])\ncorrect_index = 1\nfor scale in [1.0, 10.0]:\n    probability = (scores * scale).softmax(-1)\n    confidence, prediction = probability.max(-1)\n    print(\n        \"倍率\",\n        scale,\n        \"信心\",\n        round(confidence.item(), 4),\n        \"選擇\",\n        prediction.item(),\n        \"正確\",\n        prediction.item() == correct_index,\n    )\n",
