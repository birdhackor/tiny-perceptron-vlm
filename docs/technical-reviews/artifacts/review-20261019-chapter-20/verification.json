    {
      "page_id": "20.6",
      "snapshot": "docs/course-review-20261019/freeze-04/sources/20.6.md",
      "source_sha256": "9b8053b94a2e1abf35fc032411dcaac8dba0e42214819e4de1401d307b8d04c9",
      "code": "import torch\nfrom torch import nn\nfrom tiny_perceptron.alignment import LoRALinear\n\ntorch.manual_seed(42)\nlayer = LoRALinear(nn.Linear(4, 3), rank=2, alpha=2)\nbase_before = layer.base.weight.detach().clone()\na_before = layer.a.detach().clone()\nb_before = layer.b.detach().clone()\noptimizer = torch.optim.SGD([p for p in layer.parameters() if p.requires_grad], lr=0.1)\nloss = layer(torch.ones(1, 4)).square().mean()\nloss.backward()\noptimizer.step()\nprint(\"可更新參數\", sum(p.numel() for p in layer.parameters() if p.requires_grad))\nprint(\"原矩陣完全未變\", torch.equal(base_before, layer.base.weight))\nprint(\"修正A這一步沒變\", torch.equal(a_before, layer.a))\nprint(\"修正B真的改變\", not torch.equal(b_before, layer.b))\n",
      "code_sha256": "378882c7cb4311f30f7b715348f06660eb9c6c0c22e6424a32df448b9bffe3e3",
      "subprocess_seconds": 1.7387050410034135,
