      "code": "records = [\n    {\"family\": \"貓照片A\", \"split\": \"train\", \"question\": \"有幾隻貓？\"},\n    {\"family\": \"貓照片A\", \"split\": \"train\", \"question\": \"哪隻貓抬起前腳？\"},\n    {\"family\": \"招牌照片B\", \"split\": \"test\", \"question\": \"招牌寫什麼？\"},\n    {\"family\": \"招牌照片B\", \"split\": \"test\", \"question\": \"有沒有中文字？\"},\n]\ntrain_families = {row[\"family\"] for row in records if row[\"split\"] == \"train\"}\ntest_families = {row[\"family\"] for row in records if row[\"split\"] == \"test\"}\nprint(\"訓練家族\", sorted(train_families))\nprint(\"測試家族\", sorted(test_families))\nprint(\"兩邊都有的家族\", sorted(train_families & test_families))\n",
      "code_sha256": "84f6e7852045fc2ebffa9e3371e9c2de5b80d1a1c8e3c8e26eac0d5976897283",
