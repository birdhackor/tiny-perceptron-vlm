            "        \"generation_errors\": sum(row[\"generation_error\"] is not None for row in samples),",
            "        \"invalid_special_tokens\": sum(row[\"invalid_special_tokens\"] for row in samples),",
            "        \"ablation\": ablation,",
            "        \"skipped\": [],",
            "        \"samples\": samples,",
            "    }"
