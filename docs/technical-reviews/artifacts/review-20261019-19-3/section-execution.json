  "fence": "import json\nimport tempfile\nfrom pathlib import Path\n\nfrom tiny_perceptron.selftrained.dataset import read_records\n\n\ndef record(number, group, split, answer):\n    messages = [{\"role\": \"user\", \"content\": \"左邊是什麼？\"}, {\"role\": \"assistant\", \"content\": answer}]\n    return {\"id\": f\"r{number}\", \"group_id\": group, \"split\": split, \"task\": \"vision_relation\", \"messages\": messages}\n\n\nrows = [record(1, \"bag-boot-07\", \"train\", \"左邊是包。\"), record(2, \"bag-boot-07\", \"test\", \"左邊是短靴。\")]\nwith tempfile.TemporaryDirectory() as directory:\n    path = Path(directory) / \"records.jsonl\"\n    path.write_text(\"\\n\".join(json.dumps(row, ensure_ascii=False) for row in rows), encoding=\"utf-8\")\n    try:\n        print(\"讀入\", len(read_records([path])), \"筆\")\n    except ValueError as error:\n        print(\"拒絕：\", error)\n"
