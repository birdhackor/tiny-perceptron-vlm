  "diff": {
    "command": "git diff 5ef56bc756f3 3af7f13ef959 -- course/chapters/16.md",
    "endpoint_sha256": {
      "5ef56bc756f3": "36df4c1312242eb13942e4b653a6762da66d37b275b7cbf2c0b2929efdf4f2c7",
