    "python_fences": {
      "fence-1.py": "import torch\nfrom tiny_perceptron.alignment import sequence_log_probability\nfrom tiny_perceptron.data import IGNORE\n\nlogits = torch.tensor([[[0.0, 2.0, 0.0], [2.0, 0.0, 0.0], [0.0, 0.0, 2.0]]])\nlabels = torch.tensor([[IGNORE, 0, 2]])\nscore = sequence_log_probability(logits, labels)\nprint(\"IGNORE的值\", IGNORE)\nprint(\"整段log分數\", round(score.item(), 4))\nprint(\"還原機率\", round(score.exp().item(), 4))\n",
      "fence-2.py": "# 節錄自 tiny_perceptron/alignment.py：sequence_log_probability\ndef sequence_log_probability(logits, labels):\n    valid = labels != IGNORE\n    safe_labels = labels.masked_fill(~valid, 0)\n    selected = logits.log_softmax(-1).gather(-1, safe_labels.unsqueeze(-1)).squeeze(-1)\n    if not valid.any(-1).all():\n        raise ValueError(\"偏好回答不能没有有效 token\")\n    return (selected * valid).sum(-1)\n",
      "fence-3.py": "valid = labels != IGNORE\nsafe_labels = labels.masked_fill(~valid, 0)\nselected = logits.log_softmax(-1).gather(-1, safe_labels.unsqueeze(-1)).squeeze(-1)\nprint(\"valid\", valid.tolist(), \"safe_labels\", safe_labels.tolist())\nprint(\"每個位置取出的log機率\", [round(value, 4) for value in selected[0].tolist()])\n"
    }
