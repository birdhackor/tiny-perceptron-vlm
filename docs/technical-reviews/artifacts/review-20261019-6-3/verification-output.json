    "code": "from collections import Counter\n\ncorpus = [list(\"abab\"), list(\"abac\")]\npairs = Counter()\nfor row in corpus:\n    for left, right in zip(row, row[1:]):\n        pairs[(left, right)] += 1\npair = pairs.most_common(1)[0][0]\n\n\ndef merge(row, pair):\n    out = []\n    i = 0\n    while i < len(row):\n        if i + 1 < len(row) and tuple(row[i : i + 2]) == pair:\n            out.append(\"\".join(pair))\n            i += 2\n        else:\n            out.append(row[i])\n            i += 1\n    return out\n\n\nprint(pairs)\nprint(\"選擇\", pair, \"結果\", [merge(row, pair) for row in corpus])\n",
    "stdout": "Counter({('a', 'b'): 3, ('b', 'a'): 2, ('a', 'c'): 1})\n選擇 ('a', 'b') 結果 [['ab', 'ab'], ['ab', 'a', 'c']]\n"
