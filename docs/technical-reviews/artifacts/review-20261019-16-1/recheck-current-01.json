      "text": "import torch\nfrom torch.profiler import profile, ProfilerActivity\nfrom tiny_perceptron.model import TinyLM, ModelConfig\n\ntorch.set_num_threads(1)\nmodel = TinyLM(ModelConfig(width=8)).eval()\nids = torch.tensor([[1, 2, 3]])\nwith torch.no_grad():\n    for _ in range(3):\n        model(ids)\n    with profile(activities=[ProfilerActivity.CPU]) as p:\n        for _ in range(5):\n            result = model(ids)\nprint(\"分數形狀\", tuple(result[\"logits\"].shape))\nprint(p.key_averages().table(sort_by=\"self_cpu_time_total\", row_limit=10))\nprint(\"參數bytes\", sum(v.numel() * v.element_size() for v in model.parameters()))\n"
