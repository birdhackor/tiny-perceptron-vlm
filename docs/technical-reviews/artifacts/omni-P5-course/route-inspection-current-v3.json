      "lesson_id": "19.23",
      "before": {
        "path": "docs/course-revision-20261029-omni/reviews/P5-actual/source-freeze-v6/sources/19.23.md",
        "sha256": "18231f8b2f5882e09fd08bde6e58ddb0d8b914b0e6b8d3eff6c3be948626de60"
