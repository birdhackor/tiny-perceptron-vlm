  "current_selector_source": {
    "start_line": 126,
    "text": "def selected(result):\n    # softmax捨入可能讓不同分數顯示同機率，先按原始分數取最大。\n    # 原分數真正平手時才按固定ID；不可用清單位置挑第一個。\n    i = min(range(len(result[\"ids\"])), key=lambda j: (-float(result[\"scores\"][j]), result[\"ids\"][j]))\n    return result[\"ids\"][i]"
  },
