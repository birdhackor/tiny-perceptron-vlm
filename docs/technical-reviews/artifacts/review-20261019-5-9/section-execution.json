      "content": "import time\nimport torch\nfrom tiny_perceptron.model import TinyLM, ModelConfig\n\nmodel = TinyLM(ModelConfig(width=8))\nc = model.config\nprint(\"字表\", c.vocab_size, \"位置上限\", c.max_length, \"層數\", c.layers)\nx = torch.tensor([[1, 2, 3]])\nmodel.eval()\nwith torch.no_grad():\n    model(x)\n    start = time.perf_counter()\n    for _ in range(10):\n        model(x)\n    average_seconds = (time.perf_counter() - start) / 10\nparameters = model.description()[\"parameters\"]\nprint(\"參數格數\", parameters, \"FP32參數bytes\", parameters * 4)\nprint(\"CPU每次前向秒數\", average_seconds)\nassert parameters == 264 * 8 + 128 * 8 + 16 + 8 * 264 + 840\n"
