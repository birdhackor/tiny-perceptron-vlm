      "source_id": "s-kernel",
      "version": "PyTorch 2.14.1 / git 5c4886908584029761b579af026dcfb627c84070",
      "locator": "_vec_softmax_lastdim: max reduction, exp of difference, sum, reciprocal multiplication",
      "excerpts": [
        {
          "first_line": 74,
          "text": "      scalar_t max_input = vec::reduce_all<scalar_t>(\n          [](Vec& x, Vec& y) { return vec::maximum(x, y); },\n          input_data,\n          dim_size);\n      vec::map(\n          [max_input](Vec x) { return (x - Vec(max_input)).exp(); },\n          output_data,\n          input_data,\n          dim_size);\n      scalar_t tmp_sum = vec::reduce_all<scalar_t>(\n          [](Vec x, Vec y) { return x + y; }, output_data, dim_size);\n      tmp_sum = 1 / tmp_sum;\n      vec::map(\n          [tmp_sum](Vec x) { return x * Vec(tmp_sum); },\n          output_data,\n          output_data,\n          dim_size);"
        }
      ]
    },
