      "version": "PyTorch 2.14.1 / git 5c4886908584029761b579af026dcfb627c84070",
      "locator": "def softmax; Softmax formula; dim argument; delegation to Tensor.softmax",
      "excerpts": [
        {
          "first_line": 2176,
          "text": "def softmax(\n    input: Tensor,\n    dim: int | None = None,\n    _stacklevel: int = 3,\n    dtype: DType | None = None,\n) -> Tensor:\n"
        },
        {
          "first_line": 2186,
          "text": "    :math:`\\text{Softmax}(x_{i}) = \\frac{\\exp(x_i)}{\\sum_j \\exp(x_j)}`"
        },
        {
          "first_line": 2195,
          "text": "        dim (int): A dimension along which softmax will be computed."
        },
        {
          "first_line": 2213,
          "text": "        ret = input.softmax(dim)"
        }
      ]
    },
