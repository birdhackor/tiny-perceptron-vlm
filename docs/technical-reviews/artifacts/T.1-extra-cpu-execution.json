    {
      "section": "1.2 重複例",
      "code": "from tiny_perceptron.data import split_documents\ndocs = [\"貓看狗。\", \"狗看貓。\", \"鳥看魚。\", \"魚看鳥。\", \"貓看狗。\", \"貓看狗。\"]\nparts = split_documents(docs, seed=42)\nprint({k:len(v) for k,v in parts.items()})\nassert sum(map(len,parts.values())) == 4\n",
      "stdout": "{'train': 2, 'validation': 1, 'test': 1}\n"
    },
    {
      "section": "1.2 新句例",
      "code": "from tiny_perceptron.data import split_documents\ndocs = [\"貓看狗。\", \"狗看貓。\", \"鳥看魚。\", \"魚看鳥。\", \"貓看狗。\", \"鳥看貓。\"]\nparts = split_documents(docs, seed=42)\nprint({k:len(v) for k,v in parts.items()})\nassert sum(map(len,parts.values())) == 5\n",
      "stdout": "{'train': 3, 'validation': 1, 'test': 1}\n"
    },
    {
      "section": "12.1 880Hz例",
      "code": "from tiny_perceptron.multimodal import tone\nwave=tone(880.0)\nprint(tuple(wave.shape),[round(v,3) for v in wave[:3].tolist()],round(wave.min().item(),2),round(wave.max().item(),2))\nassert tuple(wave.shape)==(1600,)\n",
      "stdout": "(1600,) [0.0, 0.169, 0.319] -0.5 0.5\n"
    },
    {
      "section": "12.2 3200點例",
      "code": "samples=3200\nfor rate in [16000,8000]:\n    print(rate,samples/rate,rate/2,round(rate/440,2))\n",
      "stdout": "16000 0.2 8000.0 36.36\n8000 0.4 4000.0 18.18\n"
    },
    {
      "section": "12.8 width12例",
      "code": "from tiny_perceptron.multimodal import tone, log_mel, AudioEncoder\nwave=tone()[None]\nspectrogram=log_mel(wave)\nfeatures=AudioEncoder(bands=16,width=12)(wave)\nprint(tuple(spectrogram.shape),tuple(features.shape))\nassert tuple(features.shape)==(1,11,12)\n",
      "stdout": "(1, 16, 11) (1, 11, 12)\n"
    },
    {
      "section": "12.8 bands32例",
      "code": "from tiny_perceptron.multimodal import tone, log_mel, AudioEncoder\nwave=tone()[None]\nspectrogram=log_mel(wave)\nfeatures=AudioEncoder(bands=32,width=8)(wave)\nprint(tuple(spectrogram.shape),tuple(features.shape),tuple(log_mel(wave,bands=32).shape))\nassert tuple(features.shape)==(1,11,8)\n",
      "stdout": "(1, 16, 11) (1, 11, 8) (1, 32, 11)\n"
    }
  ],
