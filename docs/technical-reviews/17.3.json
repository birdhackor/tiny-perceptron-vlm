  "sources": [
    {
      "id": "s_torch",
      "kind": "official_source",
      "title": "PyTorch：abs/mean/matmul/round/allclose官方定義",
      "url": "https://raw.githubusercontent.com/pytorch/pytorch/5c4886908584029761b579af026dcfb627c84070/torch/_torch_docs.py",
      "version": "PyTorch2.14.1+cpu，官方commit5c4886908584029761b579af026dcfb627c84070",
      "sha256": "f3962a2a4973e7d4917a3b3f265903d4a534085343bbe40d003728385d1949e5",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-03",
      "authority_reason": "軟體專案官方倉庫的固定版本原始文件／原始碼，直接記錄所核對API契約。",
      "inspection_note": "abs L219–227；mean L7195–7221；matmul L7908–7930；round L9897–9952；allclose L835–858；本人親讀官方 commit 原檔。abs 逐項取絕對值；無 dim 的 mean 對全部元素取平均且要求浮點或複數；2D matmul 為矩陣乘法。round 結果 dtype 與輸入相同，decimals 指定小數位置，演算法本身仍是浮點近似，半格採偶數。allclose 預設 atol=1e-8，不能把實數分配律當成不同浮點路徑逐位相等。",
      "artifact_ids": [
        "a_source"
      ]
    },
