  "claims": [
    {
      "id": "probability-conversion",
      "kind": "concept",
      "statement": "本例[1,2,-1]含負值且和為2，不能直接當機率；對有限候選分數取exp(z)=e^z並除以候選exp總和，得到正值、加總1且保留分數排序的softmax分配。",
      "location": "course/chapters/01.md:241–243",
      "scope": "有限實數三候選貓/看/狗的數學分配；可作抽選的比例，但本節未實際抽字。",
      "status": "verified",
      "evidence": [
        {
          "source_id": "torch-softmax",
          "locator": "Softmax docstring, activation.py 1755–1780",
          "supports": "直接支持exp/sum公式及機率範圍、正規化；公式與exp單調性支持排序。"
        },
        {
          "source_id": "torch-core-apis",
          "locator": "torch.exp docstring, _torch_docs.py 4115–4138",
          "supports": "支持exp(x_i)=e^x_i的逐元素定義。"
        },
        {
          "source_id": "independent-derivation",
          "locator": "phase4-1_7-derivation.md 前三段",
          "supports": "逐步證明正值、共享正分母、和為1與排序；原分數和2。"
        }
      ],
      "artifact_ids": [
        "derivation",
        "snapshot-torch-softmax",
        "snapshot-torch-core-apis"
      ]
    },
    {
      "id": "translation-stability",
      "kind": "concept",
      "statement": "全部候選分數加同一常數在實數算術下不改softmax；先減最高分令最大指數0、權重至多1，避免本例指數過大。",
      "location": "course/chapters/01.md:245、251、255、259",
      "scope": "有限實數的比例不變性；本例及有界+100 float32檢查。不是任意浮點常數、Inf/NaN或極小概率零下溢的全面保證。",
      "status": "verified",
      "evidence": [
        {
          "source_id": "torch-softmax",
          "locator": "activation.py 1762–1764 softmax公式",
          "supports": "共享exp(c)可依原始公式抵消。"
        },
        {
          "source_id": "torch-cpu-softmax",
          "locator": "SoftMaxKernel.cpp 64–94, _vec_softmax_lastdim",
          "supports": "官方原始CPU實作取slice最大值再exp並正規化，支持減max的穩定策略。"
        },
        {
          "source_id": "independent-derivation",
          "locator": "phase4-1_7-derivation.md shared-constant equality及max subtraction段",
          "supports": "完整代數抵消和權重上界證明。"
        },
        {
          "source_id": "probe-execution",
          "locator": "probe stdout shift100/stability fields",
          "supports": "[101,102,99]直接exp全inf且比例全NaN；內建softmax有限且與原分配最大絕對差0。"
        }
      ],
      "artifact_ids": [
        "derivation",
        "probe-code",
        "probe-run",
        "probe-stdout",
        "snapshot-torch-cpu-softmax"
      ]
