  "sources": [
    {
      "id": "s_ops",
      "kind": "official_source",
      "title": "PyTorch官方arange／bitwise_not／amax／reshape定義",
      "url": "https://raw.githubusercontent.com/pytorch/pytorch/5c4886908584029761b579af026dcfb627c84070/torch/_torch_docs.py",
      "version": "PyTorch 2.14.1+cpu／commit 5c4886908584029761b579af026dcfb627c84070",
      "download_sha256": "f3962a2a4973e7d4917a3b3f265903d4a534085343bbe40d003728385d1949e5",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-03",
      "authority_reason": "PyTorch官方專案固定原始碼，版本與當前CPU安裝commit一致。",
      "inspection_note": "1686–1693 bitwise_not；7064–7085 amax；9680–9724 arange；9833–9864 reshape；親讀固定commit的官方文件原碼。布林NOT反轉真假；amax是指定軸最大值且不是另回傳argmax索引；arange預設0起、右界排除，整數參數預設int64；reshape保留元素與順序，view或copy依stride。本節是把物理格編號作為數值後取最大，不是對logits取argmax。"
    },
    {
      "id": "s_tensor",
      "kind": "official_source",
      "title": "PyTorch官方Tensor expand_as與masked_fill定義",
      "url": "https://raw.githubusercontent.com/pytorch/pytorch/5c4886908584029761b579af026dcfb627c84070/torch/_tensor_docs.py",
      "version": "PyTorch 2.14.1+cpu／commit 5c4886908584029761b579af026dcfb627c84070",
      "download_sha256": "9c3d4d0bcef8041352cc87cff68980c39ddd8c506d4e8db6410af306bd46f189",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-03",
      "authority_reason": "PyTorch官方專案固定原始碼，版本與當前CPU安裝commit一致。",
      "inspection_note": "3147–3161 masked_fill_；6199–6264 expand與expand_as；6547–6552 masked_fill；親讀expand以stride0擴展singleton維度的view，expand_as等於expand(other.size())；不應對共享view原地寫入。本節masked_fill為out-of-place，布林mask=True才換值；因此~valid處設-1，沒有改valid或positions。"
    },
    {
      "id": "s_none",
      "kind": "official_source",
      "title": "PyTorch官方None索引實作",
      "url": "https://raw.githubusercontent.com/pytorch/pytorch/5c4886908584029761b579af026dcfb627c84070/aten/src/ATen/TensorIndexing.h",
      "version": "PyTorch 2.14.1+cpu／commit 5c4886908584029761b579af026dcfb627c84070",
      "download_sha256": "871a8af3e49d0787c84c2b9390acb0ebacbd1777c830b6f3fbe94f7530b59861",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-03",
      "authority_reason": "PyTorch官方專案固定原始碼，版本與當前CPU安裝commit一致。",
      "inspection_note": "491–498 handleDimInMultiDimIndexing；660–679 get_item；親讀None索引呼叫unsqueeze，單一[None]具體unsqueeze(0)，因此[4]變[1,4]。"
    },
    {
      "id": "s_advanced",
      "kind": "official_source",
      "title": "PyTorch官方tensor進階配對索引實作",
      "url": "https://raw.githubusercontent.com/pytorch/pytorch/5c4886908584029761b579af026dcfb627c84070/aten/src/ATen/native/TensorAdvancedIndexing.cpp",
      "version": "PyTorch 2.14.1+cpu／commit 5c4886908584029761b579af026dcfb627c84070",
      "download_sha256": "02ac3a6a13269defebfa19c4de3f1af8366eb12e1ee5041b235b209a8f1a9e3f",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-03",
      "authority_reason": "PyTorch官方專案固定原始碼，版本與當前CPU安裝commit一致。",
      "inspection_note": "1–47 索引實作與broadcast說明；親讀多個tensor索引先broadcast到共同shape，按相同索引座標一起選值；這裡兩個[2]索引不是笛卡兒積。未索引的詞表軸[5]保留，所以輸出[2,5]。必要公式：selected[b,v] = logits[b,last[b],v]。"
    },
    {
      "id": "s_negative",
      "kind": "official_source",
      "title": "PyTorch官方CPU負tensor索引規則",
      "url": "https://raw.githubusercontent.com/pytorch/pytorch/5c4886908584029761b579af026dcfb627c84070/aten/src/ATen/native/cpu/IndexKernelUtils.h",
      "version": "PyTorch 2.14.1+cpu／commit 5c4886908584029761b579af026dcfb627c84070",
      "download_sha256": "c30d0e20c8cc02147878958b13f4abf6f0454c823a69a8a1e3fae63db334b50b",
      "verified": true,
      "checked_original": true,
      "accessed_on": "2026-10-03",
      "authority_reason": "PyTorch官方專案固定原始碼，版本與當前CPU安裝commit一致。",
      "inspection_note": "36–48 Indexer.get；52–61 get_1；親讀CPU多索引先檢查-size<=value<size，負值再加size。time軸size=4時-1變3，故全False產生的sentinel沒有自動報錯，也不代表語義有效token。"
    },
    {
