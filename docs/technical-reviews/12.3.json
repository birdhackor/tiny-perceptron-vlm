  "claims": [
    {
      "id": "audio-frame-api",
      "kind": "software",
      "statement": "預設tone()是一維1600點0.1秒單音；unfold(0,400,160)沿時間軸取完整400點窗，保持原樣本振幅，輸出(8,400)；torch.equal比較第一框後240點與第二框前240點得到True。",
      "location": "course/chapters/12.md:66–83（開場、原fence及輸出解說）",
      "scope": "相關tone/unfold/slice/equal API合組；只验证這一組CPU原數據與窗視圖，不包含梯度、參數更新、訓練、語音辨識或泛化。",
      "status": "verified",
      "evidence": [
        {
          "source_id": "tone",
          "locator": "tone44–46",
          "supports": "默认取樣率16000、秒數0.1，arange長度round(0.1*16000)=1600，返回1D單音。"
        },
        {
          "source_id": "pytorch-unfold",
          "locator": "_tensor_docs.py add_docstr_all(\"unfold\")5952–5990",
          "supports": "unfold回傳原tensor的window view；dimension/size/step及追加窗內axis。"
        },
        {
          "source_id": "original-run",
          "locator": "original-fence.stdout.txt全部與fence-1.py",
          "supports": "本人原樣執行得(8,400)、0.025/0.01及True。"
        },
        {
