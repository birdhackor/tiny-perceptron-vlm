  "verification_program": "\"\"\"Actual public-weight CPU application episodes; isolated from accuracy evaluation.\"\"\"\nimport os\nos.environ['CUDA_VISIBLE_DEVICES'] = ''\nos.environ['OMP_NUM_THREADS'] = '1'\nos.environ['MKL_NUM_THREADS'] = '1'\nimport hashlib\nimport json\nimport platform\nimport shlex\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\nROOT = Path.cwd().resolve()\nsys.path.insert(0, str(ROOT))\nimport torch\nfrom scripts.check_course_models import run_command, save_evidence, validate_folder\nfrom scripts.course_experiments.applications import (\n    _rag_question, _reasoning_records, _sample, _tool_episode, _tool_records,\n    _verify_reasoning,\n)\nfrom tiny_perceptron.retrieval import retrieve\nfrom tiny_perceptron.training import load_checkpoint\n\ntorch.set_num_threads(1)\ntorch.manual_seed(0)\nctx = SimpleNamespace(device='cpu')\nmanifest = ROOT / 'docs/course-experiments/public-models.json'\nmodels = {item['id']: item for item in json.loads(manifest.read_text())['models']}\n\ndef digest(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\nproof = {\n    'schema_version': 1,\n    'checked_at': datetime.now(timezone.utc).isoformat(),\n    'scope': 'Actual public weights, single generated-address retrieval, one bounded calculator episode, and one generated arithmetic-step sample on CPU. These are operation checks, not additional held-out accuracy estimates. A completed tool episode remains independently scored against its original request.',\n    'code_checkout_revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),\n    'manifest_sha256': digest(manifest),\n    'environment': {'python': platform.python_version(), 'torch': str(torch.__version__), 'device': 'cpu', 'threads': '1'},\n    'verification_program': Path(__file__).read_text(),\n    'source_sha256': {p: digest(ROOT / p) for p in ('scripts/course_experiments/applications.py', 'tiny_perceptron/retrieval.py', 'tiny_perceptron/training.py', 'tiny_perceptron/model.py', 'tiny_perceptron/data.py')},\n    'public_sources': {},\n    'checkpoints': {},\n    'operations': {},\n}\n\nfor ident in ('rag', 'tools', 'reasoning'):\n    folder = ROOT / 'checkpoints/course' / ident\n    validate_folder(models[ident], folder)\n    proof['public_sources'][ident] = {k: models[ident][k] for k in ('repo', 'revision')}\n\nrag_path = ROOT / 'checkpoints/course/rag/model.pt'\nrag_model, _ = load_checkpoint(rag_path, 'cpu')\ndocuments = [{'id': 'D0', 'text': 'K000 address=A1'}, {'id': 'D1', 'text': 'K099 address=C8'}]\nhits = retrieve('K000', documents, k=1)\nrag_prompt = _rag_question('K000', hits)\nproof['operations']['rag'] = {'documents': documents, 'query': 'K000', 'retrieved': hits, 'generation': _sample(rag_model, [{'role': 'user', 'content': rag_prompt}], ctx, tokens=16)}\nproof['checkpoints']['rag'] = {'path': str(rag_path.relative_to(ROOT)), 'sha256': digest(rag_path)}\n\ntools_path = ROOT / 'checkpoints/course/tools/model.pt'\n# This uses the actual SYSTEM, model-generated requests, strict parser, finite\n# allowlisted calculator, external TOOL_RESULT feedback and model final answer.\ntools_card = ROOT / 'docs/course-experiments/releases/tools.json'\nposted_command = json.loads(tools_card.read_text())['model_card']['inference']['commands'][0]\ncommand = shlex.split(posted_command)\nassert command[:2] == ['python', '-c'], 'Unexpected reviewed tools command'\ncommand[0] = sys.executable\ntool_command_result = run_command(command)\nassert tool_command_result['status'] == 'passed', tool_command_result\nepisode = tool_command_result['output']\nproof['operations']['tools'] = episode\nproof['tools_posted_command'] = {'literal_model_card_command': posted_command, 'source_card_sha256': digest(tools_card), 'actual_command': tool_command_result, 'subprocess_threads': 2}\nproof['checkpoints']['tools'] = {'path': str(tools_path.relative_to(ROOT)), 'sha256': digest(tools_path)}\n\nreason_path = ROOT / 'checkpoints/course/reasoning/steps.pt'\nreason_model, _ = load_checkpoint(reason_path, 'cpu')\nreason_record = next(row for row in _reasoning_records() if row['question'] == '(1+2)+3=?')\ngeneration = _sample(reason_model, [{'role': 'user', 'content': reason_record['question']}], ctx, tokens=48)\nproof['operations']['reasoning'] = {'question': reason_record['question'], 'generation': generation, 'external_verification': _verify_reasoning(generation['samples'][0], reason_record, 'steps')}\nproof['checkpoints']['reasoning'] = {'path': str(reason_path.relative_to(ROOT)), 'sha256': digest(reason_path)}\n\ngenerations = [proof['operations']['rag']['generation'], generation]\ngenerations += [event['generation'] for event in episode['trace'] if 'generation' in event]\nassert generations and episode['trace'], 'No actual model generations recorded'\nclean = all(not sample['invalid_special_tokens'] for item in generations for sample in item['samples'])\nproof['status'] = 'passed' if clean else 'failed'\nproof['operation_result_note'] = 'Pass means all three model workflows actually ran and emitted no invalid structural token. The raw tool status, exact answer and narrow arithmetic verification remain visible even when incorrect.'\ntarget = save_evidence(ROOT / 'docs/course-experiments/student-checks', 'application-workflows', proof)\nprint(json.dumps({'status': proof['status'], 'evidence': str(target), 'tool_status': episode['status'], 'actual_tool_calls': episode['actual_tool_calls'], 'tool_correct': episode['correct'], 'reasoning_verified': proof['operations']['reasoning']['external_verification']}, ensure_ascii=False))\nraise SystemExit(0 if clean else 1)\n",
